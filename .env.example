# Google Gemini API key (Required for AI Copilot, Oracle Insights, and RAG Compliance reasoning)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Flight API Key for real-time flight demand data
FLIGHT_API_KEY=your_flight_api_key_here

# RAG & Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss

# Optional: Pinecone API key (if VECTOR_STORE_TYPE is set to pinecone)
# PINECONE_API_KEY=your_pinecone_api_key_here

# Redis Broker URL (Default for local development or Docker)
REDIS_URL=redis://localhost:6379/0

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
